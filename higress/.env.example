# Which consumer may call the ai-quota admin endpoints
# (/v1/chat/completions/quota, /quota/refresh, /quota/delta).
# Must be one of the names in consumers.conf.
QUOTA_ADMIN_CONSUMER=quota-admin

# Where to read the engine credential from. apply.sh strips the surrounding
# double quotes that compose would otherwise remove for us.
SGLANG_ENV_FILE=../qwen3.6-27b-2-A100/.env
