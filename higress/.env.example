# Which consumer may call the ai-quota admin endpoints
# (/v1/chat/completions/quota, /quota/refresh, /quota/delta).
# Must be one of the names in consumers.conf.
QUOTA_ADMIN_CONSUMER=quota-admin

# Where to read the engine credential from. apply.sh strips the surrounding
# double quotes that compose would otherwise remove for us.
SGLANG_ENV_FILE=../qwen3.6-27b-2-A100/.env

# Which Redis holds the ai-quota ledger. The live stack points at the real
# ledger; a validation deployment MUST point somewhere else, because ai-quota
# decrements on every completion.
QUOTA_REDIS_DOMAIN="higress-redis.higressint"

# Where the gateway fetches plugin .wasm modules. The all-in-one serves them
# from its own plugin-server inside the container. A wrong value FAILS OPEN.
WASM_PLUGIN_BASE="http://localhost:8002"
