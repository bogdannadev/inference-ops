# Runtime state written by the apiserver: every Kubernetes object it serves,
# plus gateway certs and console session state. Root-owned (the container runs
# as root), so removing it needs a container:
#   docker run --rm -v "$PWD:/w" alpine:3 sh -c 'rm -rf /w/data'
#
# Config worth keeping lives in ./config and is installed by ./apply.sh.
data/

# ./config with secrets substituted in. Regenerated by every apply.sh run.
rendered/

# Real credentials.
.env
consumers.conf
