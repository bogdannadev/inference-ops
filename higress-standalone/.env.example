# Settings for ./apply.sh. Copy to .env and fill in.
#
# NOTE: this is NOT compose/.env. That one is written by configure.sh and
# carries the deployment's ports, image digests and encryption key. This file
# only drives the config-apply step.

# Which compose project to install config into. The validation instance runs
# under `higress-next`; the production one is `higress`.
#
# It is also the guardrail key: apply.sh refuses to install when the project is
# anything other than `higress` while QUOTA_REDIS_DOMAIN points at the
# production ledger.
COMPOSE_PROJECT="higress-next"

# Which consumer may call the ai-quota admin endpoints
# (/v1/chat/completions/quota, /quota/refresh, /quota/delta).
# Must be one of the names in ../higress/consumers.conf.
QUOTA_ADMIN_CONSUMER="quota-admin"

# Where to read the engine credential from.
SGLANG_ENV_FILE="../qwen3.6-27b-2-A100/.env"

# Which Redis holds the ai-quota ledger.
#
# ai-quota DECREMENTS this on every completion. A validation deployment must
# point at a throwaway Redis — pointing it at higress-redis.higressint would
# spend real customer balances on the first test request. apply.sh refuses that
# combination, but set it correctly rather than relying on the refusal.
#
#   validation  higress-redis-test.higressint
#   production  higress-redis.higressint
QUOTA_REDIS_DOMAIN="higress-redis-test.higressint"

# Where the gateway fetches plugin .wasm modules. In compose mode this is the
# separate plugin-server container, NOT localhost. A wrong value FAILS OPEN:
# the filter loads with no config and key-auth stops authenticating.
WASM_PLUGIN_BASE="http://plugin-server:8080"
