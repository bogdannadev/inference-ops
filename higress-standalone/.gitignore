# =============================================================================
# Official Higress standalone (compose) deployment, installed by
# get-higress.sh at v2.2.4. Committed: the upstream tree as shipped, plus
# compose/docker-compose.override.yml, which is the only file carrying our
# local deviations.
#
# Reinstalling: get-higress.sh -u re-extracts the release tarball over this
# directory. It overwrites bin/ and compose/docker-compose.yml, preserves
# compose/.env (the new one lands as compose/env_new), and never touches
# docker-compose.override.yml because that filename does not exist upstream.
# =============================================================================

# Runtime config store. The apiserver runs --storage file --file-root-dir
# /opt/data against this tree and writes every Kubernetes object it serves.
# Created root-owned with 0700 subdirectories, so removing it needs a
# container:
#   docker run --rm -v "$PWD:/w" alpine:3 sh -c 'rm -rf /w/conf'
#
# Config worth keeping is authored in ../higress/config and installed from
# ./rendered.
conf/

# ../higress/config with secrets substituted in, mounted read-only into the
# apiserver at /rendered. Regenerated by every apply run.
rendered/

# Per-component runtime state: gateway certs, istio data, proxy config,
# console session state, pilot config. Also listed in compose/.gitignore.
compose/volumes/
compose/.configured

# Written by configure.sh and edited by hand. Carries NACOS_DATA_ENC_KEY (the
# 32-character key that encrypts sensitive configuration), so it never lands
# in git. The install-time copy is kept beside it as .env.orig-install and is
# ignored for the same reason.
compose/.env
compose/.env.orig-install
compose/env_new

# ./apply.sh settings. Points at a consumer table and an engine credential.
.env

# Real consumer credentials.
consumers.conf

# Ledger snapshots taken before risky operations. Runtime data, and they
# carry per-consumer balances - keep them on the box, not in git.
backups/
