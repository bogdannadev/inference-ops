# Secrets. The glob matters: deploy/init-langfuse.sh and
# apply-clickhouse-retention.sh both write .env.bak before editing in place,
# and `.env` alone does not cover it — a backup full of live credentials was
# sitting untracked-but-committable until this was widened.
.env
.env.*
merged.yml

# Runtime data — never commit
langfuse-data/
logs/
# Engine stderr captured by deploy/roll-replica.sh before each recreation.
# Separate from logs/ because that one is root-owned by the container.
logs-archive/
grafana_data/

# Python bytecode from local syntax checks
__pycache__/
*.pyc

# Rendered from .env by deploy/render-prometheus-secrets.sh
prometheus/secrets/

# Caddy source-address allowlists (operator addresses); shape in
# caddy/allowlists.caddy.example
caddy/private/
