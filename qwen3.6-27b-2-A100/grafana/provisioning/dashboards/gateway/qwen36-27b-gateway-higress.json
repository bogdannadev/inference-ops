      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (ai_consumer) (rate(route_upstream_model_consumer_metric_llm_first_token_duration{ai_consumer=~\"$consumer\"}[$__rate_interval]))\n/ clamp_min(sum by (ai_consumer) (rate(route_upstream_model_consumer_metric_llm_stream_duration_count{ai_consumer=~\"$consumer\"}[$__rate_interval])), 1)",
          "legendFormat": "{{ai_consumer}}",
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Streaming requests only. The gateway hop itself measured +6.6ms median; anything much larger is the engine, not Higress."
    },
