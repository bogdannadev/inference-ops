        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ai_consumer) (rate(route_upstream_model_consumer_metric_llm_duration_count{ai_consumer=~\"$consumer\"}[$__rate_interval]))",
          "legendFormat": "{{ai_consumer}}",
          "refId": "A",
          "instant": false,
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean time to first token, by consumer",
      "description": "A sum over a count, so this is a MEAN and is labelled as one. ai-statistics emits no histogram, so there are no per-consumer percentiles until the request record lands in Stage B \u2014 one slow request among a hundred fast ones is invisible here.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (ai_consumer) (rate(route_upstream_model_consumer_metric_llm_first_token_duration{ai_consumer=~\"$consumer\"}[$__rate_interval])) / clamp_min(sum by (ai_consumer) (rate(route_upstream_model_consumer_metric_llm_stream_duration_count{ai_consumer=~\"$consumer\"}[$__rate_interval])), 1)",
          "legendFormat": "{{ai_consumer}}",
          "refId": "A",
          "instant": false,
          "format": "time_series",
          "range": true
        }
      ]
    },
