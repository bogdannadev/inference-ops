    {
      "type": "timeseries",
      "title": "Token rate by consumer, split by direction",
      "description": "Input and output are charged identically \u2014 ai-quota deducts input+output 1:1 and v2.2.4 has no weighting option \u2014 but they cost nothing alike. Each output token is a forward pass, and decode here is bandwidth-bound at ~50ms. Input is prefilled in one pass and, for a multi-turn agent that re-sends its context, mostly hits the radix cache: node-wide 84.8% of prompt tokens have been cache hits. A consumer sitting at 40:1 input:output is paying mostly for the cheapest thing the node does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (consumer,direction) (rate(gateway_tokens_total[$__rate_interval]))",
          "legendFormat": "{{consumer}} {{direction}}",
          "refId": "A",
          "instant": false,
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by consumer",
