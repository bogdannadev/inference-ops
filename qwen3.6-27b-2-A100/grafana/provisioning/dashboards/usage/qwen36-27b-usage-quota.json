    {
      "type": "timeseries",
      "title": "Latency p95 by consumer",
      "description": "Whole-request duration as Envoy saw it, from the access-log fact table via Vector. This did not exist before Stage B: ai-statistics emits sums and counts but no histogram, so a single 40-second request among a hundred fast ones was invisible in the per-consumer mean.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (consumer,le) (rate(gateway_request_duration_seconds_bucket{consumer=~\"$consumer\"}[$__rate_interval])))",
          "legendFormat": "{{consumer}}",
          "refId": "A",
          "instant": false,
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Status mix by consumer",
      "description": "Per-consumer outcomes, which Prometheus could not answer at all before Stage B. `unauthenticated` is the 401 path \u2014 a wrong or missing key has no consumer to attribute to, and naming it keeps that traffic visible instead of vanishing from the breakdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
