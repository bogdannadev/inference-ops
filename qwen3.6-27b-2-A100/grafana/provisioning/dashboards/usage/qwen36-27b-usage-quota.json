{
  "annotations": {
    "list": []
  },
  "description": "Per-consumer usage and quota. Balance comes from the durable ai-quota ledger via redis_exporter; rates from Higress ai-statistics; per-consumer latency and status mix from the access-log fact table via Vector. Billing reads the ledger, never the counters.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "inference",
    "usage",
    "quota",
    "billing"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "name": "consumer",
        "label": "Consumer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(consumer:quota_balance:tokens, ai_consumer)",
          "refId": "A"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "description": "Roster comes from the quota ledger, not from traffic: a key created a minute ago has a balance and no requests yet, and the access-log counters vanish from Prometheus entirely while the node is idle. All = .* rather than the OR of this list, so traffic from a consumer that is not in the ledger (or unauthenticated) still shows up instead of silently disappearing.",
        "definition": "label_values(consumer:quota_balance:tokens, ai_consumer)",
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
