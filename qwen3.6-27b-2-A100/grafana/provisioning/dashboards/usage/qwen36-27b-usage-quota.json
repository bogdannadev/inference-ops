          "legendFormat": "{{consumer}}",
          "refId": "A",
          "instant": false,
          "format": "time_series",
          "range": true
        }
      ]
    },
    {
      "type": "table",
      "title": "Status mix by consumer",
      "description": "Per-consumer outcomes, which Prometheus could not answer at all before Stage B. `unauthenticated` is the 401 path \u2014 a wrong or missing key has no consumer to attribute to, and naming it keeps that traffic visible instead of vanishing from the breakdown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
