    {
      "type": "table",
      "title": "Consumer ledger",
      "description": "Balance is the DURABLE record and is a single TOTAL-token number: ai-quota deducts input+output at the same rate and v2.2.4 has no weighting option. The in/out columns show what that total was actually made of \u2014 output tokens each cost a forward pass, while input is prefilled once and mostly radix-cache served. Spend and share come from Envoy counters, which reset on gateway restart and must never be invoiced.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 9,
        "w": 15,
        "x": 0,
        "y": 1
      },
