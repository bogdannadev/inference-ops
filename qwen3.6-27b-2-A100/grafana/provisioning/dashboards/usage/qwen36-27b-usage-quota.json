    {
      "type": "timeseries",
      "title": "Latency p95 by consumer",
      "description": "Whole-request duration as Envoy saw it, from the access-log fact table via Vector. This did not exist before Stage B: ai-statistics emits sums and counts but no histogram, so a single 40-second request among a hundred fast ones was invisible in the per-consumer mean.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
