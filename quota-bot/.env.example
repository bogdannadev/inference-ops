# Copy to .env and fill in. .env is gitignored — it holds a bot token that can
# mint API keys and move balances.

# From BotFather. Treat as equivalent to the admin credential below: anyone
# holding it can impersonate the bot to Telegram.
TELEGRAM_BOT_TOKEN=""

# 1-256 characters, only A-Z a-z 0-9 _ and -. Telegram echoes this back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call, and the bot
# rejects anything that does not match. Generate with:
#   head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9_-'
TELEGRAM_WEBHOOK_SECRET=""

# Comma-separated NUMERIC Telegram user ids. Never usernames — those can be
# released and re-registered by someone else. Get yours by messaging the bot
# once and reading the "DENIED user <id>" line from `docker logs quota-bot`.
TELEGRAM_ALLOWED_IDS=""

# The public HTTPS URL Telegram posts to. Telegram accepts ports 443, 80, 88
# and 8443 only; Caddy already owns 443. The path should be long and random —
# it is a second secret, and it keeps the endpoint out of scan logs.
#   https://<host>/tg/<random>
TELEGRAM_WEBHOOK_URL=""

# The quota-admin line from ../higress-standalone/consumers.conf, including the
# literal "Bearer " prefix. ai-quota's admin endpoints refuse every other
# consumer with a 403.
QUOTA_ADMIN_CREDENTIAL=""

# Public base URL handed to consumers in the generated OpenCode config. The
# gateway hostname, not the direct router one — the direct hostname bypasses
# authentication and metering entirely.
PUBLIC_BASE_URL="https://qw38-27b-gw.duckdns.org"

# Model advertised in the OpenCode config. `output` is the gateway's own
# request-validation ceiling, not the engine's; keep it in step with
# max_tokens in ../higress-standalone/config/wasmplugins/request-validation.yaml
# and with the 422 message in ../qwen3.6-27b-2-A100/Caddyfile.
MODEL_ID="qwen3.8-27b"
MODEL_CONTEXT="169000"
MODEL_OUTPUT="70000"

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel >
# Install connector). Long base64 string. The tunnel exists only because
# Telegram cannot reach this host directly.
CLOUDFLARE_TUNNEL_TOKEN=""

# Set to "debug" to restore per-request framework HTTP logging. Off by default:
# the 30-second healthcheck alone was 75% of the log. The bot's own one-line
# "work=..ms total=..ms" per command is usually the number you want instead.
LOG_HTTP=""
